# backend/.env — copy to backend/.env and fill in real values.
# LangChain/LangGraph auto-load this file via python-dotenv (see api/dependencies.py).

# ── LLM (required) ──────────────────────────────────────────────────────────
# NVIDIA API key for GPT-OSS-20B (openai/gpt-oss-20b), served via NVIDIA's
# OpenAI-compatible endpoint (https://integrate.api.nvidia.com/v1). Get one
# free at https://build.nvidia.com. Used by the LangGraph agent (Router +
# Agent nodes), arXiv/web summarizers, and all review/synthesis prompts.
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── External sources (required for their respective tools) ─────────────────
TAVILY_API_KEY=your_tavily_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here  # optional — raises Semantic Scholar rate limits

# ── Observability (optional but recommended) ────────────────────────────────
# Enables LangSmith tracing for every LangGraph run (Router/Agent/Tools nodes,
# tool calls, latencies, token usage) — no code changes needed, LangChain
# picks these up automatically at import time.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=research-assistant
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # default; only needed for self-hosted LangSmith

# ── Deployment (optional) ────────────────────────────────────────────────────
# Overrides the local on-disk ChromaDB path — set when running via
# docker-compose so the vector store persists in a named volume instead of
# the container's ephemeral filesystem.
# CHROMA_DB_DIR=/data/chroma_db
